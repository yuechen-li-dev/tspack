{
  "name": "@tspack/manifest-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:bridges",
    "test": "vitest run",
    "typecheck:src": "tsc -p tsconfig.build.json",
    "typecheck:manifest-api": "tsc -p tsconfig.manifest-api.json --noEmit",
    "build:bridges": "tsc -p tsconfig.bridges.json"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.6",
    "playwright": "^1.54.0"
  }
}
