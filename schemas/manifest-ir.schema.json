{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspack.dev/schemas/manifest-ir.schema.json",
  "title": "TSPack Manifest IR (M0 placeholder)",
  "type": "object",
  "required": ["format", "workspace", "packages", "diagnostics"],
  "properties": {
    "format": { "type": "string" },
    "workspace": { "type": "object" },
    "packages": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
