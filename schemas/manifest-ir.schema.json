{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspack.dev/schemas/manifest-ir.schema.json",
  "title": "TSPack Manifest IR (M1)",
  "type": "object",
  "required": [
    "format",
    "workspace",
    "packages"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "workspace": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "runtime": {
          "enum": [
            "nodejs",
            "bun",
            "deno"
          ]
        }
      },
      "additionalProperties": true
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "policies": {
            "type": "object"
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "publish": {
            "type": "object",
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "runTargets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "runtime": {
                  "type": "string"
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "url": {
                  "type": "string"
                },
                "cwd": {
                  "enum": [
                    "workspace",
                    "package"
                  ]
                },
                "ready": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "http",
                        "tcp",
                        "stdout-match"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "stream": {
                      "enum": [
                        "stdout",
                        "stderr",
                        "both"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "skyrim": {
            "type": "object",
            "description": "Explicitly opted-in Skyrim build, materialization, and launch target.",
            "required": [
              "name",
              "host",
              "runtimeVersion",
              "bridge",
              "nativeConfigure",
              "nativeBuild",
              "nativeTests",
              "nativeDll",
              "assetCompilerProject",
              "assetTestsProject",
              "assetPacks",
              "assetOutput",
              "runtimeConfig",
              "dllDestination",
              "configDestination",
              "expectedRecords",
              "runtimeEvidencePattern",
              "readyMarker"
            ],
            "properties": {
              "name": { "type": "string" },
              "host": { "type": "string" },
              "runtimeVersion": { "type": "string" },
              "bridge": { "const": "MarionetteSSE.esp" },
              "nativeConfigure": { "type": "object" },
              "nativeBuild": { "type": "object" },
              "nativeTests": { "type": "object" },
              "nativeDll": { "type": "string" },
              "assetCompilerProject": { "type": "string" },
              "assetTestsProject": { "type": "string" },
              "assetPacks": { "type": "array", "items": { "type": "object" } },
              "assetOutput": { "const": "build/assets/MarionetteSSE.esp" },
              "runtimeConfig": { "type": "string" },
              "runtimeOverrideTarget": { "type": "string" },
              "runtimeOverrideFields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "type"],
                  "properties": {
                    "path": { "type": "string" },
                    "type": { "enum": ["boolean", "string", "integer"] },
                    "secret": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              },
              "dllDestination": { "type": "string" },
              "configDestination": { "type": "string" },
              "expectedRecords": { "type": "array", "items": { "type": "object" } },
              "stalePlugins": { "type": "array", "items": { "type": "string" } },
              "runtimeEvidencePattern": { "type": "string" },
              "readyMarker": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identity", "triggers", "jobs"],
        "properties": {
          "identity": { "type": "string" },
          "triggers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["manual", "push", "pullRequest"] },
                "branches": { "type": "array", "items": { "type": "string" } },
                "paths": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["identity", "steps"],
              "properties": {
                "identity": { "type": "string" },
                "needs": { "type": "array", "items": { "type": "string" } },
                "runsOn": { "enum": ["linux", "windows", "macos", "currentHost"] },
                "matrix": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": ["string", "number", "boolean"] }
                  }
                },
                "env": { "$ref": "#/$defs/workflowEnvironment" },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["operation"],
                    "properties": {
                      "name": { "type": "string" },
                      "operation": { "enum": ["sync", "check", "pack", "process", "shellScript"] },
                      "packages": { "type": "array", "items": { "type": "string" } },
                      "command": { "type": "array", "items": { "type": "string" } },
                      "script": { "type": "string" },
                      "shell": { "enum": ["sh", "powershell"] },
                      "cwd": { "type": "string" },
                      "capabilities": { "type": "array", "items": { "type": "string" } },
                      "env": { "$ref": "#/$defs/workflowEnvironment" },
                      "timeoutSeconds": { "type": "integer", "minimum": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "workflowEnvironment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "value"],
                "properties": { "kind": { "const": "plain" }, "value": { "type": "string" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "name"],
                "properties": { "kind": { "const": "secret" }, "name": { "type": "string" } },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
