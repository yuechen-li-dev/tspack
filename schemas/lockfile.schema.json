  "$id": "https://tspack.dev/schemas/lockfile.schema.json",
  "title": "TSPack Lockfile (M0 placeholder)",
  "type": "object",
  "required": ["lock", "packages", "edges", "targets"],
  "properties": {
    "lock": { "type": "string" },
